# Token del bot (Discord Developer Portal → tu aplicación → Bot → Reset Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal → General Information)
CLIENT_ID=

# Opcional: ID de tu servidor de pruebas. Si lo pones, los comandos
# se registran al instante solo en ese servidor (ideal para probar).
GUILD_ID=

# Opcional: canal donde el bot da la bienvenida a los nuevos miembros
WELCOME_CHANNEL_ID=

# Opcional: canal para /confesar (si está vacío, se publica en el canal donde se usa)
CONFESSIONS_CHANNEL_ID=

# Color de los embeds (hexadecimal)
EMBED_COLOR=#5865F2
